{
  "name": "ecoreserve",
  "version": "1.0.0",
  "description": "Projeto de automação de testes E2E para a plataforma EcoReserve.",
  "main": "index.js",
  "scripts": {
    "start": "http-server . -p 5500 -c-1",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "keywords": [
    "qa",
    "playwright",
    "test-automation",
    "e2e"
  ],
  "author": "Vinicius",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "http-server": "^14.1.1"
  }
}
